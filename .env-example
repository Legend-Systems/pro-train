# Automatic English → European Portuguese content translation
# Provider: Google Cloud Translation API v3
#
# Credentials: prefer dedicated translate service-account vars below.
# GCS storage (GOOGLE_CLOUD_*) and Translation often use different accounts;
# reusing protrain-storage@... without roles/cloudtranslate.user causes PERMISSION_DENIED.
#
# Starter numbers based on the current catalog (5 courses, 15 tests,
# ~207 questions, ~655 options ≈ 110,000 characters for a full pass):
#   CONTENT_TRANSLATION_MAX_BATCH_CHARS=30000
#   CONTENT_TRANSLATION_MONTHLY_CHAR_BUDGET=500000
#   CONTENT_TRANSLATION_MIN_REQUEST_INTERVAL_MS=200
#
# Feature-flag defaults:
#   local/dev  — true (jobs fail-open if GCP creds are missing)
#   staging    — true
#   production — true after QA; set false to pause spend during an outage
# Set CONTENT_TRANSLATION_PROVIDER=noop in unit tests / CI.
CONTENT_AUTO_TRANSLATION_ENABLED=true
CONTENT_TRANSLATION_PROVIDER=google
CONTENT_TRANSLATION_TARGET_LOCALE=pt-PT
CONTENT_TRANSLATION_SOURCE_LOCALE=en
GOOGLE_TRANSLATE_PROJECT_ID=
# Dedicated translate service account (recommended when different from GCS):
GOOGLE_TRANSLATE_CLIENT_EMAIL=
GOOGLE_TRANSLATE_PRIVATE_KEY=
# Falls back to GOOGLE_CLOUD_CLIENT_EMAIL / GOOGLE_CLOUD_PRIVATE_KEY when unset.
CONTENT_TRANSLATION_MAX_BATCH_CHARS=30000
CONTENT_TRANSLATION_RETRY_ATTEMPTS=3
CONTENT_TRANSLATION_MIN_REQUEST_INTERVAL_MS=200
CONTENT_TRANSLATION_MONTHLY_CHAR_BUDGET=500000
